.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
        .param .u64 param_mul_c1,
        .param .u64 param_add_c1,
        .param .u64 param_x,
        .param .u64 param_add
)
{
        .reg .pred %p<2>;
        .reg .f32 %f<21>;
        .reg .b16 %h<1>;
        .reg .f64 %d<1>;
        .reg .b32 %r<11>;
        .reg .b64 %rd<20>;
        ld.param.u64 %rd1, [param_mul_c1];
        cvta.to.global.u64 %rd2, %rd1;
        ld.param.u64 %rd3, [param_add_c1];
        cvta.to.global.u64 %rd4, %rd3;
        ld.param.u64 %rd5, [param_x];
        cvta.to.global.u64 %rd6, %rd5;
        ld.param.u64 %rd7, [param_add];
        cvta.to.global.u64 %rd8, %rd7;
        mov.u32 %r1, %tid.x;
        mov.u32 %r2, %ctaid.x;
        mov.u32 %r3, %ntid.x;
        mad.lo.s32 %r4, %r2, %r3, %r1;
        and.b32 %r5, %r1, 31;
        shr.u32 %r6, %r1, 5;
        setp.ge.s32 %p1, %r4, 1024;
        @%p1 bra DONE;
        add.s64 %rd9, %rd2, 0;
        ld.global.f32 %f1, [%rd9];
        mul.lo.s32 %r7, %r4, 4;
        mul.wide.s32 %rd10, %r7, 4;
        add.s64 %rd11, %rd6, %rd10;
        ld.global.f32 %f2, [%rd11];
        mul.f32 %f3, %f1, %f2;
        add.s64 %rd12, %rd4, 0;
        ld.global.f32 %f4, [%rd12];
        add.f32 %f5, %f4, %f3;
        ld.global.f32 %f6, [%rd9];
        add.s32 %r8, %r7, 1;
        mul.wide.s32 %rd13, %r8, 4;
        add.s64 %rd14, %rd6, %rd13;
        ld.global.f32 %f7, [%rd14];
        mul.f32 %f8, %f6, %f7;
        ld.global.f32 %f9, [%rd12];
        add.f32 %f10, %f9, %f8;
        ld.global.f32 %f11, [%rd9];
        add.s32 %r9, %r7, 2;
        mul.wide.s32 %rd15, %r9, 4;
        add.s64 %rd16, %rd6, %rd15;
        ld.global.f32 %f12, [%rd16];
        mul.f32 %f13, %f11, %f12;
        ld.global.f32 %f14, [%rd12];
        add.f32 %f15, %f14, %f13;
        ld.global.f32 %f16, [%rd9];
        add.s32 %r10, %r7, 3;
        mul.wide.s32 %rd17, %r10, 4;
        add.s64 %rd18, %rd6, %rd17;
        ld.global.f32 %f17, [%rd18];
        mul.f32 %f18, %f16, %f17;
        ld.global.f32 %f19, [%rd12];
        add.f32 %f20, %f19, %f18;
        add.s64 %rd19, %rd8, %rd10;
        st.global.v4.f32 [%rd19], {%f5, %f10, %f15, %f20};
DONE:
        ret;
}
